{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chain-of-trust-lab.github.io/contexts/provenance/v1.schema.json",
  "title": "ProvenanceCredential v1",
  "description": "A W3C verifiable credential that records one pipeline step done to one artifact, linked to the run's previous credential. Terms: https://chain-of-trust-lab.github.io/contexts/provenance/v1. This schema cannot check who issued a credential: the verifier checks the issuer's role credential.",
  "type": "object",
  "required": ["@context", "id", "type", "issuer", "issuanceDate", "credentialSchema", "credentialSubject"],
  "properties": {
    "@context": {
      "type": "array",
      "prefixItems": [
        { "const": "https://www.w3.org/2018/credentials/v1" },
        { "const": "https://chain-of-trust-lab.github.io/contexts/provenance/v1.jsonld" }
      ],
      "minItems": 2
    },
    "id": { "$ref": "#/$defs/credentialId" },
    "type": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "VerifiableCredential" } },
        { "contains": { "const": "ProvenanceCredential" } },
        { "contains": { "$ref": "#/$defs/stepCredentialType" }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "issuer": {
      "description": "The agent of the actor that did the step.",
      "oneOf": [
        { "$ref": "#/$defs/did" },
        { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/did" } } }
      ]
    },
    "issuanceDate": { "type": "string", "format": "date-time" },
    "credentialSchema": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "const": "https://chain-of-trust-lab.github.io/contexts/provenance/v1.schema.json" },
        "type": { "const": "JsonSchemaValidator2018" }
      }
    },
    "credentialSubject": {
      "type": "object",
      "description": "The artifact the step acted on.",
      "required": ["id", "type", "name", "digest", "step", "pipelineRun"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "type": { "$ref": "#/$defs/artifactType" },
        "name": { "$ref": "#/$defs/artifactName" },
        "digest": { "$ref": "#/$defs/digest" },
        "location": { "description": "Where the publish step put the artifact.", "type": "string", "minLength": 1 },
        "step": {
          "enum": [
            "commit",
            "build-package",
            "test-package",
            "deliver-package",
            "build-image",
            "test-image",
            "deliver-image",
            "approve",
            "deploy"
          ]
        },
        "inputs": {
          "description": "The artifacts the subject was built from.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "previousCredential": {
          "type": "object",
          "required": ["id", "credentialDigest"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/credentialId" },
            "credentialDigest": {
              "description": "sha256 of the RFC 8785 (JCS) canonical JSON of the previous signed credential, proof included.",
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "pipelineRun": {
          "type": "object",
          "required": ["id", "repository", "workflow", "workflowDigest", "runId", "runAttempt"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[0-9]+/attempts/[0-9]+$"
            },
            "repository": { "$ref": "#/$defs/repository" },
            "workflow": { "type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$" },
            "workflowDigest": { "$ref": "#/$defs/sha256" },
            "runId": { "type": "string", "pattern": "^[0-9]+$" },
            "runAttempt": { "type": "string", "pattern": "^[1-9][0-9]*$" }
          }
        },
        "sbomDigest": { "$ref": "#/$defs/sha256" },
        "result": { "enum": ["Passed", "Failed"] },
        "reportDigest": { "$ref": "#/$defs/sha256" },
        "registry": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+$" },
        "decision": { "enum": ["Approved", "Rejected"] },
        "environment": { "enum": ["Staging", "Production"] }
      },
      "allOf": [{ "$ref": "#/$defs/artifactRules" }]
    }
  },
  "allOf": [
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "SourceCommittedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "commit" }, "type": { "const": "SourceRevision" } },
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["inputs"] }, { "required": ["previousCredential"] },
              { "required": ["sbomDigest"] }, { "required": ["result"] }, { "required": ["reportDigest"] },
              { "required": ["registry"] }, { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "PackageBuiltCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": {
              "step": { "const": "build-package" },
              "type": { "const": "Package" },
              "inputs": { "items": { "properties": { "type": { "const": "SourceRevision" } } } }
            },
            "required": ["previousCredential", "inputs", "sbomDigest", "reportDigest"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["result"] }, { "required": ["registry"] },
              { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "PackageTestedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "test-package" }, "type": { "const": "Package" } },
            "required": ["previousCredential", "result", "reportDigest"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["inputs"] }, { "required": ["sbomDigest"] },
              { "required": ["registry"] }, { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "PackagePublishedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "deliver-package" }, "type": { "const": "Package" } },
            "required": ["previousCredential", "location", "registry"],
            "not": { "anyOf": [
              { "required": ["inputs"] }, { "required": ["sbomDigest"] }, { "required": ["result"] },
              { "required": ["reportDigest"] }, { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "ImageBuiltCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": {
              "step": { "const": "build-image" },
              "type": { "const": "DeployableImage" },
              "inputs": { "items": { "properties": { "type": { "const": "Package" } } } }
            },
            "required": ["previousCredential", "inputs"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["sbomDigest"] }, { "required": ["result"] },
              { "required": ["reportDigest"] }, { "required": ["registry"] }, { "required": ["decision"] },
              { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "ImageTestedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "test-image" }, "type": { "const": "DeployableImage" } },
            "required": ["previousCredential", "result", "reportDigest"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["inputs"] }, { "required": ["sbomDigest"] },
              { "required": ["registry"] }, { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "ImagePublishedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "deliver-image" }, "type": { "const": "DeployableImage" } },
            "required": ["previousCredential", "location", "registry"],
            "not": { "anyOf": [
              { "required": ["inputs"] }, { "required": ["sbomDigest"] }, { "required": ["result"] },
              { "required": ["reportDigest"] }, { "required": ["decision"] }, { "required": ["environment"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "ImageApprovedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "approve" }, "type": { "const": "DeployableImage" } },
            "required": ["previousCredential", "decision", "environment"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["inputs"] }, { "required": ["sbomDigest"] },
              { "required": ["result"] }, { "required": ["reportDigest"] }, { "required": ["registry"] }
            ] }
          }
        }
      }
    },
    {
      "if": { "$ref": "#/$defs/isType", "properties": { "type": { "contains": { "const": "ImageDeployedCredential" } } } },
      "then": {
        "properties": {
          "credentialSubject": {
            "properties": { "step": { "const": "deploy" }, "type": { "const": "DeployableImage" } },
            "required": ["previousCredential", "environment"],
            "not": { "anyOf": [
              { "required": ["location"] }, { "required": ["inputs"] }, { "required": ["sbomDigest"] },
              { "required": ["result"] }, { "required": ["reportDigest"] }, { "required": ["registry"] },
              { "required": ["decision"] }
            ] }
          }
        }
      }
    }
  ],
  "$defs": {
    "isType": { "required": ["type"], "properties": { "type": { "type": "array" } } },
    "stepCredentialType": {
      "enum": [
        "SourceCommittedCredential",
        "PackageBuiltCredential",
        "PackageTestedCredential",
        "PackagePublishedCredential",
        "ImageBuiltCredential",
        "ImageTestedCredential",
        "ImagePublishedCredential",
        "ImageApprovedCredential",
        "ImageDeployedCredential"
      ]
    },
    "did": { "type": "string", "pattern": "^did:sov:[1-9A-HJ-NP-Za-km-z]{21,22}$" },
    "credentialId": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "repository": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sha1": { "type": "string", "pattern": "^sha1:[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "digest": { "anyOf": [{ "$ref": "#/$defs/sha1" }, { "$ref": "#/$defs/sha256" }] },
    "artifactId": { "type": "string", "pattern": "^urn:(git:sha1:[0-9a-f]{40}|sha256:[0-9a-f]{64})$" },
    "artifactType": { "enum": ["SourceRevision", "Package", "DeployableImage"] },
    "artifactName": { "type": "string", "minLength": 1 },
    "artifact": {
      "type": "object",
      "required": ["id", "type", "name", "digest"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/artifactId" },
        "type": { "$ref": "#/$defs/artifactType" },
        "name": { "$ref": "#/$defs/artifactName" },
        "digest": { "$ref": "#/$defs/digest" }
      },
      "allOf": [{ "$ref": "#/$defs/artifactRules" }]
    },
    "artifactRules": {
      "description": "A source revision is a git commit, named by its repository URL. A package is named by its Maven purl, an image by its reference. Both are identified by their sha256 digest.",
      "allOf": [
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "SourceRevision" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^urn:git:sha1:" },
              "digest": { "$ref": "#/$defs/sha1" },
              "name": { "$ref": "#/$defs/repository" }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "Package" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^urn:sha256:" },
              "digest": { "$ref": "#/$defs/sha256" },
              "name": { "pattern": "^pkg:maven/" }
            }
          }
        },
        {
          "if": { "required": ["type"], "properties": { "type": { "const": "DeployableImage" } } },
          "then": {
            "properties": {
              "id": { "pattern": "^urn:sha256:" },
              "digest": { "$ref": "#/$defs/sha256" },
              "name": { "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[a-z0-9._/-]+(:[A-Za-z0-9_.-]+)?$" }
            }
          }
        }
      ]
    }
  }
}
